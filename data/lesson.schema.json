{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/lesson.schema.json",
  "title": "Japanese AI Learning lesson",
  "type": "object",
  "required": ["schemaVersion", "title", "description"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "catalog": {
      "type": "object",
      "properties": {
        "listed": { "type": "boolean" },
        "order": { "type": "number" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "chinese": { "type": "string" },
          "pages": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "chapter": { "type": "string" }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": ".+\\|.+" },
          {
            "type": "object",
            "required": ["japanese", "chinese"],
            "properties": {
              "japanese": { "type": "string", "minLength": 1 },
              "plainText": { "type": "string" },
              "chinese": { "type": "string", "minLength": 1 },
              "grammarNote": { "type": "string" },
              "examples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["chinese"],
                  "anyOf": [
                    { "required": ["plain"] },
                    { "required": ["japanese"] },
                    { "required": ["ruby"] }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "supplementalSections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "chapter": { "type": "string" },
        "title": { "type": "string" },
        "items": { "type": "array" }
      }
    }
  }
}
